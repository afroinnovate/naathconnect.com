# Copy to .env.local for a real Supabase project. Leave the Supabase
# values empty to use the local demo database (Node SQLite). No secrets
# belong in this file. Do not create a hosting account from this preview.

# --- Production data layer (Supabase Postgres + Auth). Not provisioned. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to sign anonymous event-view proofs so a public
# Supabase anon key cannot mint views. Generate a long random string
# and store the same value in naath_private.secrets (name = view_hmac).
# See supabase/migrations/001_init.sql.
VIEW_SIGNING_SECRET=

# --- Local demo only. Used when the Supabase URL above is empty. ---
# These passwords are placeholders for `npm run dev` on Node 22.
# Do not set them on Amplify. The SQLite demo is not part of the serverless build.
DEMO_SESSION_SECRET=replace-with-a-long-random-string
DEMO_ADMIN_EMAIL=placeholder-admin@example.invalid
DEMO_ADMIN_PASSWORD=placeholder-admin-password
DEMO_PROFESSIONAL_PASSWORD=placeholder-professional-password
